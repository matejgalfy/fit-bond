# Frontend build/runtime configuration (Vite — baked in at build time).
#
# Base URL for the REST API.
#   dev:  http://localhost:3000  (backend dev server directly, cross-origin)
#   prod: /api                   (same origin; the Caddy proxy strips /api)
VITE_API_URL=http://localhost:3000

# Origin for better-auth (it appends `/api/auth` itself).
#   dev:  http://localhost:3000
#   prod: leave unset — falls back to the current origin (same-origin proxy)
VITE_AUTH_URL=http://localhost:3000
