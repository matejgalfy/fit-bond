{
    "name": "backend",
    "version": "1.0.50",
    "scripts": {
        "test": "bun test",
        "dev": "bun run --watch src/index.ts",
        "lint": "eslint --config ../../eslint.config.js .",
        "lint:fix": "eslint --config ../../eslint.config.js --fix .",
        "format": "prettier --write .",
        "db:up": "docker compose up -d",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:seed": "bun src/db/seed.ts",
        "db:setup": "bun run db:up && bun -e \"await new Promise(r => setTimeout(r, 3000))\" && bun run db:migrate && bun run db:seed",
        "db:clear": "bun src/db/reset.ts"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.6.2",
        "@elysiajs/cors": "^1.4.1",
        "@elysiajs/openapi": "^1.4.14",
        "better-auth": "^1.6.2",
        "drizzle-orm": "^0.45.1",
        "drizzle-zod": "^0.8.3",
        "elysia": "^1.4.28",
        "pg": "^8.20.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@faker-js/faker": "^10.3.0",
        "@types/bun": "^1.3.11",
        "@types/node": "^25.5.0",
        "@types/pg": "^8.18.0",
        "bun-types": "latest",
        "drizzle-kit": "^0.31.10",
        "drizzle-seed": "^0.3.1",
        "eslint": "^9.39.4",
        "globals": "^17.4.0",
        "prettier": "^3.4.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "module": "src/index.js"
}
