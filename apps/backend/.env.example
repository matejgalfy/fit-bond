# Database Configuration
# Local Docker PostgreSQL connection string for development
# Default credentials: dev_user / password
DATABASE_URL=postgres://dev_user:password@localhost:5432/fitbound

BACKEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google OAuth — REQUIRED, the backend refuses to boot without these (auth.ts).
# Create OAuth credentials in the Google Cloud Console and add the callback
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LocationIQ geocoding API
# Sign up at https://locationiq.com — free tier is 5k requests/day.
LOCATIONIQ_API_KEY=

# Resend (transactional email). Optional in dev — leave it commented out and a
# dummy key is used (emails simply aren't delivered). If set, it must be
# non-empty: an empty value throws at startup.
# RESEND_API_KEY=
