{
    "name": "fit-bond",
    "module": "index.ts",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/bun": "latest",
        "eslint": "^9.39.4",
        "eslint-plugin-react-dom": "^2.13.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-react-x": "^2.13.0",
        "globals": "^17.5.0",
        "prettier": "^3.4.2",
        "typescript-eslint": "^8.56.1"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "private": true,
    "scripts": {
        "dev:backend": "bun --filter backend dev",
        "dev:frontend": "bun --filter frontend dev",
        "dev": "bun run dev:backend & bun run dev:frontend",
        "db:setup": "bun --filter backend db:setup",
        "lint:backend": "cd apps/backend && bun run lint",
        "lint:frontend": "cd apps/frontend && bun run lint",
        "lint": "bun run lint:backend && bun run lint:frontend",
        "lint:fix": "bun run lint:backend --fix 2>/dev/null; bun run lint:frontend --fix 2>/dev/null",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:backend": "bun --filter backend test",
        "test:frontend": "bun --filter frontend test",
        "test": "bun run test:backend && bun run test:frontend"
    },
    "type": "module",
    "workspaces": [
        "apps/*"
    ],
    "dependencies": {
        "resend": "^6.12.3"
    }
}
