erDiagram
    USER ||--o{ USER_PREFERRED_SPORT : prefers
    USER ||--o{ USER_LOCATION : sets
    USER ||--o{ EVENT : organizes
    USER ||--o{ EVENT_PARTICIPANT : joins
    USER ||--o{ EVENT_INTERESTED : marks_interest
    USER ||--o{ COMMENT : writes
    USER ||--o{ NOTIFICATION : receives
    USER ||--o{ REPORT : submits
    USER ||--o{ REPORT : resolves

    SPORT ||--o{ EVENT : categorizes
    LOCATION ||--o{ EVENT : hosts
    LOCATION ||--o{ USER_LOCATION : referenced_by

    EVENT ||--o{ EVENT_PARTICIPANT : has_participants
    EVENT ||--o{ EVENT_INTERESTED : has_interested_users
    EVENT ||--o{ COMMENT : has_comments
    EVENT ||--o{ NOTIFICATION : triggers

    COMMENT ||--o{ COMMENT : has_replies

    USER {
        uuid id PK
        string oauth_provider
        string oauth_id
        string first_name
        string last_name
        string email
        string profile_picture_url
        text bio
        string role
        boolean is_banned
        datetime banned_until
        text banned_reason
        datetime created_at
        datetime updated_at
        datetime deleted_at
    }

    SPORT ||--o{ USER_PREFERRED_SPORT : preferred_by

    USER_PREFERRED_SPORT {
        uuid user_id PK,FK
        uuid sport_id PK,FK
    }

    USER_LOCATION {
        uuid id PK
        uuid user_id FK
        uuid location_id FK
        int radius
        string label
        boolean is_primary
        datetime created_at
    }

    SPORT {
        uuid id PK
        string name
        string icon
        text description
        datetime deleted_at
    }

    LOCATION {
        uuid id PK
        string address
        string city
        string country
        float latitude
        float longitude
        datetime deleted_at
    }

    EVENT {
        uuid id PK
        uuid organizer_id FK
        uuid location_id FK
        uuid sport_id FK
        string name
        text description
        string skill_level
        datetime start_time
        int duration
        int capacity
        int current_participants
        boolean is_public
        string cover_image_url
        datetime cancelled_at
        text cancellation_reason
        datetime created_at
        datetime updated_at
        datetime deleted_at
    }

    EVENT_PARTICIPANT {
        uuid event_id PK,FK
        uuid user_id PK,FK
    }

    EVENT_INTERESTED {
        uuid event_id PK,FK
        uuid user_id PK,FK
    }

    COMMENT {
        uuid id PK
        uuid event_id FK
        uuid user_id FK
        uuid parent_comment_id FK
        text content
        string deleted_by
        text deletion_reason
        datetime created_at
        datetime updated_at
        datetime deleted_at
    }

    NOTIFICATION {
        uuid id PK
        uuid user_id FK
        string type
        string title
        text message
        uuid event_id FK
        uuid related_user_id FK
        boolean is_read
        datetime read_at
        datetime created_at
    }

    REPORT {
        uuid id PK
        uuid reporter_id FK
        string report_type
        uuid target_id
        string reason
        string status
        uuid resolved_by FK
        text resolution
        datetime created_at
    }