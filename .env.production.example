# Production environment: used by docker-compose.yml, and on the k3s server by
# scripts/deploy.sh, which turns it into the `fitbond-env` Secret (docs/DEPLOY.md).
# Copy to `.env.production` and fill in real values (the copy is gitignored).
# No quotes around values: kubectl --from-env-file keeps them literally.

# --- Public address (Caddy, docker compose only) ---
# On k3s this is ignored: the Ingress host comes from FRONTEND_URL below.
# The domain Caddy serves. A bare domain triggers automatic HTTPS via Let's
# Encrypt (requires a public DNS record for it + ports 80/443 reachable).
# Use http://localhost for local testing without a cert.
SITE_ADDRESS=fit-bond.app
# Optional: Let's Encrypt account email for expiry notices.
ACME_EMAIL=

# --- PostgreSQL (consumed by the `db` service) ---
POSTGRES_USER=fitbond
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitbound

# --- Backend ---
# Host `db` is the compose service and also the k3s Service name.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://fitbond:change-me@db:5432/fitbound
PORT=3000

# Public origin (must match SITE_ADDRESS, scheme included). better-auth builds
# OAuth callbacks from this, e.g. https://fit-bond.dev/api/auth/callback/google
# — register that URI in the Google console. FRONTEND_URL also feeds
# better-auth's trustedOrigins. (Locally: http://localhost.)
BACKEND_URL=https://fit-bond.app
BETTER_AUTH_URL=https://fit-bond.app
FRONTEND_URL=https://fit-bond.app

# better-auth signing secret — REQUIRED in production (the image runs with
# NODE_ENV=production). Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth credentials. Optional: leave both empty to turn Google sign-in
# off (the button disappears, email + password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional third-party services. RESEND_API_KEY must be NON-EMPTY even if you
# don't send email — an empty value throws. Use a dummy `re_...` placeholder
# (emails simply won't be delivered) or a real key.
LOCATIONIQ_API_KEY=
RESEND_API_KEY=re_dummy_test_key
